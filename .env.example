# Copy to .env (git-ignored) or to ~/.futures-mcp/.env (read from any working
# directory; a local .env overrides it). Everything is optional.

# --- TradingView capture ------------------------------------------------------
# Empty = anonymous capture on TradingView's default chart.
# Set your `sessionid` cookie to capture on your own saved layout instead.
TRADINGVIEW_SESSION_ID=
# Your saved layout, used only in session mode.
TRADINGVIEW_URL=https://www.tradingview.com/chart/
# Mode used when a request doesn't ask for one (anonymous | session). Empty = session
# when a cookie is set above, otherwise anonymous. Each chart request can still pick
# its mode, e.g. "show it on my layout".
FUTURES_MCP_DEFAULT_MODE=

# --- Paths (relative paths resolve against the server's working directory) ----
# Claude Desktop starts servers from an arbitrary directory: use absolute paths there.
FUTURES_MCP_DATA_DIR=data
FUTURES_MCP_DETECTOR_DIR=private
# Only if tesseract is not on PATH (Windows default install is found automatically).
TESSERACT_CMD=

# --- Tuning -------------------------------------------------------------------
# Seconds an open (still-trading) window's bars may be served from cache.
FUTURES_MCP_LIVE_CACHE_TTL=300
# Show the Chromium window while capturing (debugging).
FUTURES_MCP_HEADFUL=false
